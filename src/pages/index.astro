---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import Link from "@components/Link.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import { Image } from "astro:assets";
import portrait from "@assets/jason-tang-portrait.jpeg";

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_PROJECTS_ON_HOMEPAGE);



---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white">
      Hi, I'm Jason <span class="text-xl">👋🏻</span> 
    </h4>
    <div class="space-y-16">
      <section>
        <div class="home-intro">
          <article class="home-intro__copy space-y-4">
            <p class="animate">
              Hi, I’m Jason Tang—an applied scientist with a background in Geography and Geocomputation.
            </p>

            <p class="animate">
              Today, my work spans applied machine learning, data, reinforcement-learning environments, multimodal models, geospatial analysis, and agentic systems.
            </p>

            <p class="animate">
              I care deeply about the “why”: using data and AI not only to optimise processes, but also to address fairness, resources, and inequality. This is where I share projects, reflections, and the occasional experiment in AI, maps, and applied science.
            </p>
          </article>
          <div class="home-intro__portrait animate">
            <Image
              src={portrait}
              alt="Jason Tang holding a dachshund in front of a city skyline"
              widths={[256, 384, 512]}
              sizes="(min-width: 768px) 13rem, 10rem"
            />
          </div>
        </div>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Selected work
          </h5>
          <Link href="/projects">
            Visit the archive
          </Link>
        </div>
        <div class="project-list project-list--compact">
          {projects.map((project, index) => <ProjectCard entry={project} index={index} />)}
        </div>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Let's Connect
        </h5>
        <article>
          <p>
            If you want to get in touch with me about something or just to say hi,
            reach out on social media or send me an email.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
